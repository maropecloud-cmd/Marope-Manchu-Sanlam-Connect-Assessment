{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-dd'T'HH:mm:ss.fff'Z'",
        "JsonWriterOptions": {
          "Indented": false
        }
      }
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 1048576
    }
  },
  "Api": {
    "EnableApiReference": false
  },
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "CommandTimeoutSeconds": 30,
    "MaxRetryCount": 5,
    "MaxRetryDelay": "00:00:10"
  },
  "Ingestion": {
    "MaxBatchSize": 500,
    "MaxClockSkew": "00:05:00",
    "SupportedCurrencies": [ "ZAR", "NAD", "BWP", "USD", "EUR", "GBP" ],
    "KnownSourceSystems": [ "life-admin", "investments", "health", "short-term" ]
  },
  "Statements": {
    "MaxWindow": "366.00:00:00"
  }
}
